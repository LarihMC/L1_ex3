<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Média do Aluno</title>
</head>

<body>

    <h2>Média do Aluno</h2>

    <form action="/resultado" method="POST">

        <label for="nota1">Primeira nota:</label>
        <input type="number" name="nota1" id="nota1" step="0.1">

        <br><br>

        <label for="nota2">Segunda nota:</label>
        <input type="number" name="nota2" id="nota2" step="0.1">

        <br><br>

        <button type="submit">Calcular</button>

    </form>

    <% if (typeof resultado !== "undefined") { %>

        <h3>Resultado</h3>

        <p>Primeira nota: <%= resultado.nota1 %></p>
        <p>Segunda nota: <%= resultado.nota2 %></p>
        <p>Média: <%= resultado.media %></p>
        <p>Conceito: <%= resultado.conceito %></p>

    <% } else { %>

        <p>Digite as duas notas para calcular a média.</p>

    <% } %>

</body>
</html>